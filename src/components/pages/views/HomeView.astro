---
/**
 * HomeView — the landing page body.
 *
 * Shared by the default-locale route (`/`) and the locale-prefixed route
 * (`/<locale>`). Copy comes from `pages.home.*` and the shared `aicx.*` keys.
 *
 * The order answers a first-time visitor's questions in turn: what AICX is,
 * what happens at a CyberSaturday, when the next one is, who attends, why
 * attend and why present, what gets explored, who has presented, and what the
 * community believes.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import { Hero } from '@/components/hero';
import Button from '@/components/ui/form/Button/Button.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import SectionHeading from '@/components/aicx/SectionHeading.astro';
import FormatSteps from '@/components/aicx/FormatSteps.astro';
import AudienceGrid from '@/components/aicx/AudienceGrid.astro';
import TopicAreas from '@/components/aicx/TopicAreas.astro';
import CompanyMarquee from '@/components/aicx/CompanyMarquee.astro';
import SessionCard from '@/components/aicx/SessionCard.astro';
import Philosophy from '@/components/aicx/Philosophy.astro';
import ClosingCta from '@/components/aicx/ClosingCta.astro';
import ExchangeDiagram from '@/components/aicx/ExchangeDiagram.astro';
import LogoShowcase from '@/components/aicx/LogoShowcase.astro';
import type Dictionary from '@/i18n/en.json';
import { t, tData, defaultLocale, localizedPath } from '@/i18n';
import { getSessions, upcomingSessions, participatingCompanies } from '@/lib/sessions';
import { getJoinLink, getPresentLink } from '@/lib/community';

interface Props {
  /** Locale whose copy and content this page renders. Defaults to the site default. */
  locale?: string;
}

interface Reason {
  icon: string;
  title: string;
  description: string;
}

const { locale = defaultLocale } = Astro.props;

const home = tData<(typeof Dictionary)['pages']['home']>('pages.home', locale)!;
const aicx = tData<(typeof Dictionary)['aicx']>('aicx', locale)!;
const whyAttend = aicx.whyAttend.items as Reason[];
const whyPresent = aicx.whyPresent.items as Reason[];

const sessions = await getSessions(locale);
const next = upcomingSessions(sessions)[0];
const companies = participatingCompanies(sessions);

const join = getJoinLink(locale);
const present = getPresentLink(locale);
const joinAttrs = join.external
  ? {
      target: '_blank',
      rel: 'noopener noreferrer',
      'aria-label': t('aicx.session.opensInNewTab', locale, { label: home.hero.primary }),
    }
  : {};

const url = (path: string) => localizedPath(path, locale);
---

<PageLayout
  title={home.meta.title}
  description={home.meta.description}
  includeOrgSchema
  footerBackground="secondary"
>
  <!-- Hero -->
  <Hero layout="split" size="lg" class="home-hero isolate" showHeroHalo>
    <Badge slot="badge" variant="brand" pill>
      <span class="relative flex h-2 w-2" aria-hidden="true">
        <span
          class="live-dot bg-brand-500 absolute inline-flex h-full w-full rounded-full opacity-60"
        ></span>
        <span class="bg-brand-500 relative inline-flex h-2 w-2 rounded-full"></span>
      </span>
      {home.hero.badge}
    </Badge>
    <h1 slot="title" class="!text-4xl sm:!text-5xl lg:!text-6xl">{home.hero.title}</h1>
    <p slot="description">{home.hero.description}</p>
    <Fragment slot="actions">
      <Button size="lg" href={join.href} {...joinAttrs}>
        {home.hero.primary}
        <Icon name="arrow-right" size="sm" />
      </Button>
      <Button size="lg" variant="outline" href={present.href} class="hero-btn-opaque">
        <Icon name="mic" size="sm" />
        {home.hero.secondary}
      </Button>
    </Fragment>
    <div slot="aside" class="mx-auto hidden w-full max-w-xl sm:block">
      <ExchangeDiagram locale={locale} />
    </div>
  </Hero>

  <!-- Companies that have presented -->
  {
    companies.length > 0 && (
      <section class="bg-background border-border border-t py-12 sm:py-16">
        <div class="mx-auto flex max-w-6xl flex-col gap-8 px-6">
          <p class="text-foreground-muted text-center text-sm font-medium sm:text-base" data-reveal>
            {home.companies.strip}{' '}
            <a
              href={url('/sessions')}
              class="text-brand-600 dark:text-brand-400 font-semibold underline-offset-4 hover:underline"
            >
              {home.companies.link}
            </a>
          </p>
          <CompanyMarquee companies={companies} locale={locale} label={home.companies.heading} />
        </div>
      </section>
    )
  }

  <!-- What AICX is -->
  <section class="bg-background-secondary border-border border-t py-[var(--space-section-md)]">
    <div
      class="mx-auto grid max-w-6xl gap-10 px-6 lg:grid-cols-[1.15fr_1fr] lg:items-start lg:gap-14"
    >
      <div class="flex flex-col gap-6">
        <SectionHeading
          badge={home.intro.badge}
          icon="network"
          heading={home.intro.heading}
          align="left"
        />
        {
          aicx.longDescription.map((text: string, i: number) => (
            <p
              class="text-foreground-muted text-lg leading-relaxed"
              data-reveal
              data-reveal-delay={i || undefined}
            >
              {text}
            </p>
          ))
        }
      </div>
      <div class="flex flex-col gap-8 lg:mt-14">
        <div data-reveal>
          <LogoShowcase locale={locale} />
        </div>
        <Card
          variant="elevated"
          padding="lg"
          class="relative overflow-hidden"
          data-reveal
          data-reveal-delay="1"
        >
          <div class="mission-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
          <div class="relative flex flex-col gap-6">
            <p
              class="text-brand-600 dark:text-brand-400 font-mono text-xs font-semibold tracking-[0.18em] uppercase"
            >
              {home.intro.cardTitle}
            </p>
            <p
              class="font-display text-foreground text-2xl leading-snug font-semibold text-balance sm:text-3xl"
            >
              {aicx.mission}
            </p>
            <p class="text-foreground-muted text-base leading-relaxed">{aicx.positioning}</p>
            <Button variant="brand-outline" href={url('/about')} class="self-start">
              {home.intro.link}
              <Icon name="arrow-right" size="sm" />
            </Button>
          </div>
        </Card>
      </div>
    </div>
  </section>

  <!-- CyberSaturday format -->
  <section class="bg-background border-border border-t py-[var(--space-section-md)]">
    <div class="mx-auto flex max-w-6xl flex-col gap-12 px-6">
      <SectionHeading
        badge={home.format.badge}
        icon="calendar"
        heading={home.format.heading}
        lead={home.format.lead}
      />
      <FormatSteps locale={locale} />
      <div class="flex justify-center" data-reveal>
        <Button variant="brand-outline" href={url('/cybersaturdays')}>
          {home.format.link}
          <Icon name="arrow-right" size="sm" />
        </Button>
      </div>
    </div>
  </section>

  <!-- Next session -->
  <section class="bg-background-secondary border-border border-t py-[var(--space-section-md)]">
    <div class="mx-auto flex max-w-4xl flex-col gap-10 px-6">
      <SectionHeading
        badge={home.upcoming.badge}
        icon="calendar-days"
        heading={home.upcoming.heading}
      />
      <div data-reveal>
        {
          next ? (
            <SessionCard session={next} locale={locale} />
          ) : (
            <Card variant="elevated" padding="lg" class="text-center">
              <div class="mx-auto flex max-w-xl flex-col items-center gap-4 py-4">
                <span class="bg-brand-500/10 text-brand-500 flex h-12 w-12 items-center justify-center rounded-2xl">
                  <Icon name="calendar-clock" size="lg" />
                </span>
                <h3 class="font-display text-foreground text-2xl font-semibold">
                  {t('pages.upcoming.empty.title', locale)}
                </h3>
                <p class="text-foreground-muted leading-relaxed">
                  {t('pages.upcoming.empty.description', locale)}
                </p>
                <Button href={join.href} {...joinAttrs}>
                  {home.hero.primary}
                  <Icon name="arrow-right" size="sm" />
                </Button>
              </div>
            </Card>
          )
        }
      </div>
      {
        next && (
          <div class="flex justify-center" data-reveal>
            <Button variant="brand-outline" href={url('/upcoming')}>
              {home.upcoming.link}
              <Icon name="arrow-right" size="sm" />
            </Button>
          </div>
        )
      }
    </div>
  </section>

  <!-- Audience -->
  <section class="bg-background border-border border-t py-[var(--space-section-md)]">
    <div class="mx-auto flex max-w-6xl flex-col gap-12 px-6">
      <SectionHeading
        badge={home.audience.badge}
        icon="users"
        heading={home.audience.heading}
        lead={home.audience.lead}
      />
      <AudienceGrid locale={locale} />
      <div class="flex justify-center" data-reveal>
        <Button variant="brand-outline" href={url('/community')}>
          {home.audience.link}
          <Icon name="arrow-right" size="sm" />
        </Button>
      </div>
    </div>
  </section>

  <!-- Why attend / why present -->
  <section class="bg-background-secondary border-border border-t py-[var(--space-section-md)]">
    <div class="mx-auto grid max-w-6xl gap-6 px-6 lg:grid-cols-2">
      {
        [
          {
            key: 'attend',
            data: home.paths.attend,
            items: whyAttend,
            icon: 'user-round',
            href: join.href,
            attrs: joinAttrs,
          },
          {
            key: 'present',
            data: home.paths.present,
            items: whyPresent,
            icon: 'mic',
            href: present.href,
            attrs: {},
          },
        ].map((path, i) => (
          <Card
            variant="elevated"
            padding="lg"
            class:list={[
              'path-card flex flex-col gap-6',
              path.key === 'present' && 'path-card-present',
            ]}
            data-reveal
            data-reveal-delay={i || undefined}
          >
            <div class="flex flex-col gap-4">
              <Badge variant="brand" pill class="self-start">
                <Icon name={path.icon} size="sm" />
                {path.data.badge}
              </Badge>
              <h2 class="font-display text-foreground text-3xl font-bold tracking-tight">
                {path.data.heading}
              </h2>
              <p class="text-foreground-muted text-lg">{path.data.lead}</p>
            </div>
            <ul class="flex flex-1 flex-col gap-3">
              {path.items.map((item) => (
                <li class="flex items-start gap-3">
                  <Icon name="check" size="sm" class="text-brand-500 mt-1 shrink-0" />
                  <p class="text-foreground-muted text-sm leading-relaxed">
                    <span class="text-foreground font-semibold">{item.title}.</span>{' '}
                    {item.description}
                  </p>
                </li>
              ))}
            </ul>
            <Button
              href={path.href}
              variant={path.key === 'present' ? 'primary' : 'brand-outline'}
              class="self-start"
              {...path.attrs}
            >
              {path.data.cta}
              <Icon name="arrow-right" size="sm" />
            </Button>
          </Card>
        ))
      }
    </div>
  </section>

  <!-- What we explore -->
  <section class="bg-background border-border border-t py-[var(--space-section-md)]">
    <div class="mx-auto flex max-w-6xl flex-col gap-10 px-6">
      <SectionHeading badge={home.topics.badge} icon="telescope" heading={home.topics.heading} />
      <TopicAreas locale={locale} />
    </div>
  </section>

  <!-- Philosophy -->
  <section class="bg-background-secondary border-border border-t py-[var(--space-section-md)]">
    <div class="mx-auto max-w-6xl px-6">
      <Philosophy locale={locale} badge={t('pages.about.philosophy.badge', locale)} />
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="bg-background border-border border-t py-[var(--space-section-md)]">
    <ClosingCta
      locale={locale}
      heading={home.cta.heading}
      description={home.cta.description}
      primary={{ label: home.cta.primary, ...join }}
      secondary={{ label: home.cta.secondary, ...present }}
    />
  </section>
</PageLayout>

<style>
  .mission-grid {
    background-image:
      linear-gradient(
        to right,
        color-mix(in oklch, var(--color-brand-500) 8%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        to bottom,
        color-mix(in oklch, var(--color-brand-500) 8%, transparent) 1px,
        transparent 1px
      );
    background-size: 28px 28px;
    -webkit-mask-image: radial-gradient(ellipse at top right, #000 0%, transparent 65%);
    mask-image: radial-gradient(ellipse at top right, #000 0%, transparent 65%);
  }
  :global(.path-card-present) {
    border-color: color-mix(in oklch, var(--color-brand-500) 35%, transparent);
  }
  .live-dot {
    animation: live-ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes live-ping {
    75%,
    100% {
      transform: scale(2.2);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .live-dot {
      animation: none;
    }
  }
</style>
