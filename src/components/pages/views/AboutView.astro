---
/**
 * AboutView — what AI & Cyber Exchange is, why it exists, and how it differs
 * from a presentation-only meetup.
 *
 * Shared by `/about` and `/<locale>/about`. Copy from `pages.about.*` and the
 * shared `aicx.*` keys.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import { Hero } from '@/components/hero';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Accordion from '@/components/ui/overlay/Accordion/Accordion.astro';
import SectionHeading from '@/components/aicx/SectionHeading.astro';
import ReasonGrid from '@/components/aicx/ReasonGrid.astro';
import Philosophy from '@/components/aicx/Philosophy.astro';
import ClosingCta from '@/components/aicx/ClosingCta.astro';
import type Dictionary from '@/i18n/en.json';
import { tData, defaultLocale } from '@/i18n';
import { getJoinLink, getPresentLink } from '@/lib/community';

interface Props {
  locale?: string;
}

interface FaqItem {
  question: string;
  answer: string;
}

const { locale = defaultLocale } = Astro.props;
const page = tData<(typeof Dictionary)['pages']['about']>('pages.about', locale)!;
const aicx = tData<(typeof Dictionary)['aicx']>('aicx', locale)!;
const faqItems = (page.faq.items as FaqItem[]).map((item) => ({
  title: item.question,
  content: item.answer,
}));
---

<PageLayout title={page.meta.title} description={page.meta.description} footerBackground="default">
  <Hero layout="centered" size="sm" class="isolate pb-[var(--space-section-sm)]" showHeroHalo>
    <Badge slot="badge" variant="brand" pill>
      <Icon name="network" size="sm" />
      {page.hero.badge}
    </Badge>
    <h1 slot="title" class="!text-4xl sm:!text-5xl lg:!text-6xl">{page.hero.title}</h1>
    <p slot="description">{page.hero.description}</p>
  </Hero>

  <!-- Who we are -->
  <section class="bg-background-secondary border-border border-t py-[var(--space-section-md)]">
    <div class="mx-auto grid max-w-6xl gap-10 px-6 lg:grid-cols-[1fr_1.3fr] lg:gap-16">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <SectionHeading
          badge={page.story.badge}
          icon="users"
          heading={page.story.heading}
          align="left"
        />
        <p
          class="border-brand-500 font-display text-foreground mt-6 border-l-2 pl-5 text-xl leading-snug font-semibold text-balance"
          data-reveal
        >
          {aicx.positioning}
        </p>
      </div>
      <div class="flex flex-col gap-6">
        {
          aicx.longDescription.map((text: string, i: number) => (
            <p
              class="text-foreground-muted text-lg leading-relaxed"
              data-reveal
              data-reveal-delay={i || undefined}
            >
              {text}
            </p>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Differentiator -->
  <section class="bg-background border-border border-t py-[var(--space-section-md)]">
    <div class="mx-auto grid max-w-6xl gap-10 px-6 lg:grid-cols-2 lg:items-center lg:gap-16">
      <SectionHeading
        badge={page.differentiator.badge}
        icon="monitor-play"
        heading={aicx.differentiator.heading}
        lead={aicx.differentiator.lead}
        align="left"
      />
      <Card variant="elevated" padding="lg" data-reveal data-reveal-delay="1">
        <ol class="divide-border flex flex-col divide-y">
          {
            aicx.differentiator.items.map((item: string, i: number) => (
              <li class="flex items-center gap-4 py-3.5 first:pt-0 last:pb-0">
                <span class="text-brand-600 dark:text-brand-400 font-mono text-xs font-semibold">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="text-foreground text-base font-medium">{item}</span>
              </li>
            ))
          }
        </ol>
      </Card>
    </div>
  </section>

  <!-- What to expect -->
  <section class="bg-background-secondary border-border border-t py-[var(--space-section-md)]">
    <div class="mx-auto flex max-w-6xl flex-col gap-10 px-6">
      <SectionHeading
        badge={page.whatWeAreNot.badge}
        icon="graduation-cap"
        heading={page.whatWeAreNot.heading}
      />
      <ReasonGrid items={page.whatWeAreNot.items} columns={3} />
    </div>
  </section>

  <!-- Philosophy -->
  <section class="bg-background border-border border-t py-[var(--space-section-md)]">
    <div class="mx-auto max-w-6xl px-6">
      <Philosophy locale={locale} badge={page.philosophy.badge} />
    </div>
  </section>

  <!-- FAQ -->
  <section
    id="faq"
    class="bg-background-secondary border-border scroll-mt-20 border-t py-[var(--space-section-md)]"
  >
    <div class="mx-auto flex max-w-3xl flex-col gap-10 px-6">
      <SectionHeading
        badge={page.faq.badge}
        icon="message-circle-question"
        heading={page.faq.heading}
      />
      <div data-reveal>
        <Accordion items={faqItems} variant="card" />
      </div>
    </div>
  </section>

  <section class="bg-background border-border border-t py-[var(--space-section-md)]">
    <ClosingCta
      locale={locale}
      heading={page.cta.heading}
      description={page.cta.description}
      primary={{ label: page.cta.primary, ...getJoinLink(locale) }}
      secondary={{ label: page.cta.secondary, ...getPresentLink(locale) }}
    />
  </section>
</PageLayout>
