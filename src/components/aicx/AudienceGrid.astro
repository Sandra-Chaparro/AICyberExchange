---
/**
 * AudienceGrid — the four groups that make up the community, from
 * `aicx.audience.groups`.
 */
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import { tData, defaultLocale } from '@/i18n';

interface Props {
  locale?: string;
}

interface Group {
  icon: string;
  title: string;
  description: string;
}

const { locale = defaultLocale } = Astro.props;
const groups = tData<{ groups: Group[] }>('aicx.audience', locale)!.groups;
---

<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  {
    groups.map((group, i) => (
      <li
        class="border-border bg-card hover:border-brand-500/40 relative flex flex-col gap-4 rounded-2xl border p-6 transition-colors duration-200"
        data-reveal
        data-reveal-delay={i || undefined}
      >
        <span class="bg-brand-500/10 text-brand-600 dark:text-brand-400 flex h-11 w-11 items-center justify-center rounded-xl">
          <Icon name={group.icon} size="md" />
        </span>
        <h3 class="font-display text-foreground text-lg font-semibold">{group.title}</h3>
        <p class="text-foreground-muted text-sm leading-relaxed">{group.description}</p>
      </li>
    ))
  }
</ul>
