---
import UpcomingView from '@/components/pages/views/UpcomingView.astro';
import { getSecondaryLocales } from '@/i18n';

// Locale-prefixed route (`/<locale>/upcoming`). One page per non-default locale;
// emits nothing when i18n is off.
export function getStaticPaths() {
  return getSecondaryLocales().map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
---

<UpcomingView locale={locale} />
