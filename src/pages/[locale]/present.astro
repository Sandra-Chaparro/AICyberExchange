---
import PresentView from '@/components/pages/views/PresentView.astro';
import { getSecondaryLocales } from '@/i18n';

// Locale-prefixed route (`/<locale>/present`). One page per non-default locale;
// emits nothing when i18n is off.
export function getStaticPaths() {
  return getSecondaryLocales().map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
---

<PresentView locale={locale} />
